{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://k-beauty-ai-api.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://k-beauty-ai-api.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://k-beauty-ai-api.onrender.com/docs"
    },
    {
      "source": "/docs/:path*",
      "destination": "https://k-beauty-ai-api.onrender.com/docs/:path*"
    },
    {
      "source": "/openapi.json",
      "destination": "https://k-beauty-ai-api.onrender.com/openapi.json"
    }
  ]
}
